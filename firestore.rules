
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isUserOneOfRoles(roles) {
      return request.auth.token.role in roles;
    }

    match /users/{userId} {
      // Allow reading/listing by specific roles, required for admin panel, chat, and dropdowns.
      allow list: if isUserOneOfRoles(['Admin', 'Sales Rep', 'Director']);
      allow read: if request.auth.uid == userId || isUserOneOfRoles(['Admin', 'Sales Rep', 'Director']);
      // Only a user can write to their own document.
      allow write: if request.auth.uid == userId;
    }

    match /leads/{leadId} {
      allow create: if isUserOneOfRoles(['Admin', 'Sales Rep', 'Director']);
      allow update, delete: if request.auth.uid == resource.data.ownerId || isUserOneOfRoles(['Admin', 'Director', 'Structure']);
      allow read: if 
        request.auth.uid == resource.data.ownerId || 
        request.auth.uid == resource.data.structureTeamMemberId ||
        isUserOneOfRoles(['Admin', 'Viewer', 'Director']) ||
        (isUserOneOfRoles(['Structure']) && resource.data.status in ['Structure Pending', 'Site Visit Done', 'IN Design', 'Quotation Send']);
      allow list: if isUserOneOfRoles(['Admin', 'Viewer', 'Director', 'Sales Rep', 'Structure']);
    }

    match /tasks/{taskId} {
      allow read: if 
        request.auth.uid == resource.data.assigneeId || 
        request.auth.uid == resource.data.createdBy ||
        isUserOneOfRoles(['Admin', 'Director']);
      allow create, update, delete: if request.auth.uid == resource.data.assigneeId || request.auth.uid == resource.data.createdBy;
    }

    match /conversations/{conversationId} {
        allow read, write: if request.auth.uid in resource.data.participants;

        match /messages/{messageId} {
          allow read, create: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
    }
  }
}
