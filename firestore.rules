rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is an Admin
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Users can read their own user document, Admins can read any user document
    match /users/{userId} {
      allow read: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      allow create: if isAuthenticated(); // For new user registration
      allow update: if isAuthenticated() && request.auth.uid == userId; // Users can update their own profile
      allow delete: if isAdmin(); // Only Admins can delete users
    }
    
    // Settings can only be read by authenticated users, and written by admins
    match /settings/{docId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Leads can be read by their owner, assigned structure team member, or certain roles.
    // Leads can be created by authenticated users.
    // Leads can be updated by their owner, assigned member, or Admin/Director.
    match /leads/{leadId} {
      allow read: if isAuthenticated() && 
                    (request.auth.uid == resource.data.ownerId ||
                     request.auth.uid == resource.data.structureTeamMemberId ||
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Director', 'Viewer']);
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() &&
                    (request.auth.uid == resource.data.ownerId ||
                     request.auth.uid == resource.data.structureTeamMemberId ||
                     get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Director']);
      allow delete: if isAdmin();
    }
    
    // Tasks can be read/updated by the assignee. Only the creator or an admin can delete.
    match /tasks/{taskId} {
        allow read, update: if isAuthenticated() && request.auth.uid == resource.data.assigneeId;
        allow create: if isAuthenticated();
        allow delete: if isAuthenticated() && (request.auth.uid == resource.data.createdBy || isAdmin());
    }
    
    // Conversations can be accessed only by participants.
    match /conversations/{conversationId} {
        allow read, write: if isAuthenticated() && request.auth.uid in resource.data.participants;
        
        // Messages can be read by conversation participants, and created by the author.
        match /messages/{messageId} {
            allow read: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
            allow create: if isAuthenticated() && request.auth.uid == request.resource.data.authorId;
        }
    }
  }
}