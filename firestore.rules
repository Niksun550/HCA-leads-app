rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to get user role
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can list all users to start a conversation
      allow list: if request.auth != null;
      // A user can read their own document, or an admin can
      allow read: if request.auth.uid == userId || getUserRole(request.auth.uid) == 'Admin';
      // A user can update their own document, or an admin can
      allow write: if request.auth.uid == userId || getUserRole(request.auth.uid) == 'Admin';
    }

    // Rules for the 'leads' collection
    match /leads/{leadId} {
      function isOwner() {
        return request.auth.uid == resource.data.ownerId;
      }
      function isStructureTeamMember() {
        return request.auth.uid == resource.data.structureTeamMemberId;
      }
      function isPrivilegedUser() {
        return getUserRole(request.auth.uid) in ['Admin', 'Director', 'Viewer'];
      }

      allow read: if isPrivilegedUser() || isOwner() || isStructureTeamMember();
      allow list: if isPrivilegedUser();
      allow write: if isPrivilegedUser() || isOwner() || isStructureTeamMember();
    }

    // Rules for the 'tasks' collection
    match /tasks/{taskId} {
       allow read, write: if request.auth.uid == resource.data.assigneeId || request.auth.uid == resource.data.createdBy;
    }
    
    // Rules for the 'conversations' collection and its subcollections
    match /conversations/{conversationId} {
      // Allow list operations (queries) if the user is a participant
      allow list: if request.auth.uid in query.filters.participants;
      // Allow read/write to a specific document if the user is a participant
      allow read, write: if request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
