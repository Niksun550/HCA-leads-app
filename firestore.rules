
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      // Check if the user making the request has the 'Admin' role in their user document.
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isOwner(doc) {
      return request.auth.uid == doc.ownerId;
    }

    function isAssignee(doc) {
      return request.auth.uid == doc.assigneeId;
    }

    function isStructureMember(doc) {
        return request.auth.uid == doc.structureTeamMemberId;
    }
    
    function isParticipant(doc) {
        return request.auth.uid in doc.participants;
    }

    // --- Rules for collections ---
    
    // Users Collection
    match /users/{userId} {
      // Any authenticated user can list the users collection (needed for dropdowns)
      allow list: if request.auth != null;
      // Users can get/update their own document, Admins can do anything
      allow get, update: if request.auth.uid == userId || isAdmin();
    }
    
    // Branches Collection
    match /branches/{branchId} {
      // Any authenticated user can read the list of branches
      allow list, get: if request.auth != null;
      // Only admins can create or modify branches
      allow create, update, delete: if isAdmin();
    }
    
    // Settings Collection
    match /settings/{settingId} {
      allow get: if request.auth != null;
      allow write: if isAdmin();
    }

    // Leads Collection
    match /leads/{leadId} {
      // Users can read/write leads they own or are assigned to. Admins can read/write any lead.
      allow get: if isOwner(resource.data) || isStructureMember(resource.data) || isAdmin();
      allow list: if request.auth != null; // Allow listing based on client-side queries
      allow create: if request.auth != null;
      allow update: if isOwner(resource.data) || isStructureMember(resource.data) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // Tasks Collection
    match /tasks/{taskId} {
      // Users can manage tasks they are assigned to. Admins can manage any task.
      allow get: if isAssignee(resource.data) || isAdmin();
      allow list: if request.auth != null; // Allow listing based on client-side queries
      allow create: if request.auth != null;
      allow update: if isAssignee(resource.data) || isAdmin();
      allow delete: if isAssignee(resource.data) || isAdmin();
    }

    // Conversations Collection
    match /conversations/{conversationId} {
        allow get, list, create, update: if isParticipant(resource.data);
    }
  }
}
