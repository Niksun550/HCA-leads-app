rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }
    
    match /conversations/{conversationId} {
      // A user can create a conversation if they are authenticated and they are one of the participants
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      
      // A user can read or update a conversation if they are one of the participants
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        // A user can read messages if they are part of the parent conversation
        allow read: if request.auth != null && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[? request.auth.uid] == [request.auth.uid];
        // A user can create a message if they are part of the parent conversation and are the sender
        allow create: if request.auth != null && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants[? request.auth.uid] == [request.auth.uid] && request.resource.data.senderId == request.auth.uid;
      }
    }
  }
}
