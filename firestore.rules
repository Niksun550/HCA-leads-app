rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isUserOneOfRoles(roles) {
      return request.auth.token.role in roles;
    }

    match /users/{userId} {
      allow read: if request.auth.uid == userId || isUserOneOfRoles(['Admin']);
      allow write: if request.auth.uid == userId;
    }

    match /leads/{leadId} {
      allow create;
      allow read, update, delete: if request.auth.uid == resource.data.ownerId;
    }

    match /tasks/{taskId} {
      allow create;
      allow read, update, delete: if request.auth.uid == resource.data.assigneeId || request.auth.uid == resource.data.createdBy;
    }
  }
}
