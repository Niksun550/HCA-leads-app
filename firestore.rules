
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Users can read their own user document and admins can read any.
    match /users/{userId} {
      allow read: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
      allow write: if request.auth.uid == userId;
      // Allow any authenticated user to create their own user document during signup
      allow create: if request.auth.uid == userId;
    }
    
    // Allow users to manage their own leads, with special access for roles.
    match /leads/{leadId} {
      allow read, write: if request.auth != null && 
                          (resource.data.ownerId == request.auth.uid || 
                           resource.data.structureTeamMemberId == request.auth.uid ||
                           get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Viewer', 'Director']);
      allow create: if request.auth != null;
    }

    // Allow users to manage their own tasks.
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && resource.data.assigneeId == request.auth.uid;
      allow create: if request.auth != null;
    }
    
    // Conversations and messages
    match /conversations/{conversationId} {
      allow read, write: if request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
