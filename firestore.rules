rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users can read/write their own user document, admins can read any.
    match /users/{userId} {
      allow read: if request.auth.uid != null;
      allow write: if request.auth.uid == userId;
    }

    // Leads can be read by their owner, the assigned structure team member, or any admin/viewer/director.
    // Leads can be created by Sales Reps and Admins.
    // Leads can be updated by their owner, the assigned structure team member, or any admin.
    // Leads can be deleted only by Admins.
    match /leads/{leadId} {
      allow list: if request.auth.token.role in ['Admin', 'Viewer', 'Director', 'Structure'];
      allow read: if request.auth.uid == resource.data.ownerId 
                  || request.auth.uid == resource.data.structureTeamMemberId
                  || request.auth.token.role in ['Admin', 'Viewer', 'Director'];
      allow create: if request.auth.token.role in ['Sales Rep', 'Admin', 'Director'];
      allow update: if request.auth.uid == resource.data.ownerId 
                  || request.auth.uid == resource.data.structureTeamMemberId
                  || request.auth.token.role == 'Admin'
                  || request.auth.token.role == 'Structure';
      allow delete: if request.auth.token.role == 'Admin';
    }
    
    match /leads/{leadId}/messages/{messageId} {
        allow read, write: if get(/databases/$(database)/documents/leads/$(leadId)).data.ownerId == request.auth.uid
                            || request.auth.uid == get(/databases/$(database)/documents/leads/$(leadId)).data.structureTeamMemberId
                            || request.auth.token.role in ['Admin', 'Director'];
    }

    match /conversations/{conversationId} {
      allow read, write: if request.auth.uid in resource.data.participants;
    }
    
    match /conversations/{conversationId}/messages/{messageId} {
       allow read, write: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    // Tasks can be read/written by the assignee or creator.
    match /tasks/{taskId} {
      allow list: if request.auth.uid != null;
      allow read, write: if request.auth.uid == resource.data.assigneeId || request.auth.uid == resource.data.createdBy;
    }
  }
}
