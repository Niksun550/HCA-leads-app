
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
    
    match /leads/{leadId} {
        allow read, write: if request.auth != null; // Broad access, refine if needed

        match /messages/{messageId} {
            allow read, create: if request.auth != null && exists(/databases/$(database)/documents/leads/$(leadId));
        }
    }
    
    match /tasks/{taskId} {
      allow read, write: if request.auth != null && request.auth.uid == resource.data.assigneeId;
      allow create: if request.auth != null;
    }
  }
}
