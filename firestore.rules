
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }
    
    function getUserRole() {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == 'Admin';
    }
    
    function isSalesOrAdmin() {
        let role = getUserRole();
        return isSignedIn() && (role == 'Admin' || role == 'Sales Rep');
    }

    // Users collection
    match /users/{userId} {
      // Admins can read/write any user document
      // Users can read their own document
      // Users can update their own document
      allow read, update: if isAdmin() || isUser(userId);
      // Only admins can create or delete users (creation happens on backend, deletion via cloud function)
      allow create, delete: if isAdmin();
    }

    // Leads collection
    match /leads/{leadId} {
      // Admins and Directors can read/write all leads.
      // Sales Reps can read/write leads they own.
      // Structure team can read/write leads assigned to them or in a structure status.
      // Viewers can read all leads.
      allow read: if isSignedIn() && 
                    (
                      getUserRole() in ['Admin', 'Director', 'Viewer'] || 
                      (getUserRole() == 'Sales Rep' && resource.data.ownerId == request.auth.uid) ||
                      (getUserRole() == 'Structure' && (resource.data.structureTeamMemberId == request.auth.uid || resource.data.status in ['Site Visit Done', 'IN Design', 'Quotation Send', 'Structure Pending']))
                    );
      
      allow create, update: if isSignedIn() && 
                    (
                      getUserRole() in ['Admin', 'Director', 'Sales Rep'] ||
                      (getUserRole() == 'Structure' && (resource.data.structureTeamMemberId == request.auth.uid || resource.data.status in ['Site Visit Done', 'IN Design', 'Quotation Send', 'Structure Pending']))
                    );

      // Only Admins can delete leads.
      allow delete: if isAdmin();
    }

    // Tasks collection
    match /tasks/{taskId} {
      // Users can read/write tasks assigned to them.
      // Admins can read/write any task.
      allow read, create, update: if isSignedIn() && (isAdmin() || resource.data.assigneeId == request.auth.uid);
      // Only the creator or an admin can delete a task.
      allow delete: if isSignedIn() && (isAdmin() || resource.data.createdBy == request.auth.uid);
    }
    
    // Conversations collection
    match /conversations/{conversationId} {
        // Only participants of the conversation can read/write
        allow read, write: if isSignedIn() && request.auth.uid in resource.data.participants;
    }

    // Settings collection
    match /settings/{docId} {
      // All authenticated users can read settings (like branding logo).
      // Only Admins can write to settings.
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }
    
    // Branches collection
    match /branches/{branchId} {
        // All authenticated users can read branches (for dropdowns).
        // Only Admins can create/update/delete branches.
        allow read: if isSignedIn();
        allow write: if isAdmin();
    }
  }
}
