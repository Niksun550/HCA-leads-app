rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuth() {
      return request.auth != null;
    }
    
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isOneOfRoles(roles) {
      return isAuth() && getRole() in roles;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    match /users/{userId} {
      // Any authenticated user can read user profiles (for names, roles, etc.)
      // Only the user themselves or an Admin can modify the profile.
      allow read: if isAuth();
      allow write: if isOwner(userId) || isOneOfRoles(['Admin']);
    }
    
    match /branches/{branchId} {
      // Any authenticated user can read the list of branches.
      // Only an Admin can create or modify branches.
      allow read: if isAuth();
      allow create, update, delete: if isOneOfRoles(['Admin']);
    }
    
    match /settings/branding {
      // Any authenticated user can read branding settings (like the logo).
      // Only an Admin can change branding.
      allow read: if isAuth();
      allow write: if isOneOfRoles(['Admin']);
    }

    match /leads/{leadId} {
      // Complex read logic:
      // - Admins, Viewers, Directors can see everything.
      // - A user can see a lead if they are the owner OR the assigned structure team member.
      // - A structure member can see any lead that has a status relevant to them.
      allow read: if isAuth() && 
                    (isOneOfRoles(['Admin', 'Viewer', 'Director']) || 
                    resource.data.ownerId == request.auth.uid ||
                    resource.data.structureTeamMemberId == request.auth.uid ||
                    (isOneOfRoles(['Structure']) && resource.data.status in ['Site Visit Done', 'IN Design', 'Quotation Send', 'Structure Pending']));
      
      // Creating a lead is restricted to sales-related roles.
      allow create: if isAuth() && isOneOfRoles(['Admin', 'Sales Rep', 'Director']);
      
      // Updating a lead is allowed for owners, assigned members, or high-level roles.
      allow update: if isAuth() && (isOneOfRoles(['Admin', 'Director']) || resource.data.ownerId == request.auth.uid || resource.data.structureTeamMemberId == request.auth.uid);
      
      // Only Admins can delete leads.
      allow delete: if isOneOfRoles(['Admin']);
    }

    match /tasks/{taskId} {
       // A user can read a task if they are assigned to it.
       // Admins/Directors can read all tasks.
       allow read: if isAuth() && (resource.data.assigneeId == request.auth.uid || isOneOfRoles(['Admin', 'Director']));
       
       // Any authenticated user can create a task (e.g., for themselves or others).
       allow create: if isAuth();
       
       // The assignee, creator, or an Admin/Director can update a task.
       allow update: if isAuth() && (resource.data.assigneeId == request.auth.uid || resource.data.createdBy == request.auth.uid || isOneOfRoles(['Admin', 'Director']));
       
       // The creator or an Admin can delete a task.
       allow delete: if isAuth() && (resource.data.createdBy == request.auth.uid || isOneOfRoles(['Admin']));
    }
    
  }
}
