
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check for Admin role
    function isAdmin() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    // Helper function to check if the user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Users collection rules
    match /users/{userId} {
      // Any authenticated user can create their own user document during registration
      allow create: if isAuthenticated() && request.auth.uid == userId;
      // Any authenticated user can read public user profiles (for chat lists, dropdowns)
      allow read: if isAuthenticated();
      // Users can update their own document, and Admins can update any document
      allow update: if (isAuthenticated() && request.auth.uid == userId) || isAdmin();
      // Only Admins can delete users
      allow delete: if isAdmin();
    }

    // Leads collection rules
    match /leads/{leadId} {
      allow read: if isAuthenticated(); // Allow general read access, filtering happens in client-side queries
      allow create: if isAuthenticated() && (request.resource.data.ownerId == request.auth.uid || isAdmin());
      allow update: if isAuthenticated() && (resource.data.ownerId == request.auth.uid || resource.data.structureTeamMemberId == request.auth.uid || isAdmin());
      allow delete: if isAdmin();
    }

    // Tasks collection rules
    match /tasks/{taskId} {
      allow read, update: if isAuthenticated() && (resource.data.assigneeId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated(); // User can create tasks for themselves or others
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || isAdmin());
    }

    // Conversations collection rules
    match /conversations/{conversationId} {
      allow read, create, update: if isAuthenticated() && request.auth.uid in resource.data.participants;
    }

    // Settings collection rules (e.g., branding)
    match /settings/{settingId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Branches collection rules
    match /branches/{branchId} {
        allow read: if isAuthenticated();
        allow write: if isAdmin();
    }
  }
}
