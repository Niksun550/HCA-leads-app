
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // USERS
    // Allow authenticated users to read user data
    // Only admins can change roles
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.token.role == 'Admin' 
                   || request.auth.uid == userId; // Allow users to update their own profile
    }

    // LEADS
    // Granular access control for leads based on user role
    match /leads/{leadId} {
      allow read: if request.auth != null && (
                    request.auth.token.role == 'Admin' ||
                    request.auth.token.role == 'Viewer' ||
                    request.auth.token.role == 'Director' ||
                    (request.auth.token.role == 'Sales Rep' && resource.data.ownerId == request.auth.uid) ||
                    (request.auth.token.role == 'Structure' && (resource.data.structureTeamMemberId == request.auth.uid || resource.data.status == 'Structure Pending'))
                  );
      allow create: if request.auth != null && (
                      request.auth.token.role == 'Admin' || 
                      request.auth.token.role == 'Sales Rep'
                    );
      allow update: if request.auth != null && (
                      request.auth.token.role == 'Admin' ||
                      (request.auth.token.role == 'Sales Rep' && resource.data.ownerId == request.auth.uid) ||
                      (request.auth.token.role == 'Structure' && resource.data.structureTeamMemberId == request.auth.uid)
                    );
      allow delete: if request.auth.token.role == 'Admin';
    }

    // CONVERSATIONS
    // Only participants can read/update a conversation and its messages
    match /conversations/{conversationId} {
      allow read, update: if request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
