rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    match /leads/{leadId} {
      allow read, write: if request.auth.uid == resource.data.ownerId || request.auth.uid == resource.data.structureTeamMemberId || request.auth.token.role == 'Admin' || request.auth.token.role == 'Viewer' || request.auth.token.role == 'Director';
      allow create: if request.auth != null;
      allow delete: if request.auth.token.role == 'Admin';
    }

    match /leads/{leadId}/messages/{messageId} {
        allow read, write: if get(/databases/$(database)/documents/leads/$(leadId)).data.ownerId == request.auth.uid || request.auth.token.role == 'Admin';
    }

    match /conversations/{conversationId} {
        allow read, update: if request.auth.uid in resource.data.participants;
        allow create: if request.auth.uid in request.resource.data.participants;
    }

    match /conversations/{conversationId}/messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
    }

    match /tasks/{taskId} {
      // Allow read/write if the user is the assignee or creator of the task.
      allow read, write: if request.auth.uid == resource.data.assigneeId || request.auth.uid == resource.data.createdBy;
      
      // Allow a user to list tasks assigned to them.
      allow list: if request.auth.uid == request.query.filters.assigneeId;

      // Allow any authenticated user to create a task.
      allow create: if request.auth != null;

      // Allow the creator or an admin to delete a task.
      allow delete: if request.auth.uid == resource.data.createdBy || request.auth.token.role == 'Admin';
    }
  }
}
