rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isUserInRole(role) {
      return getUserData(request.auth.uid).role == role;
    }

    function getUserData(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data;
    }

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read: if request.auth != null;
      allow update: if request.auth.uid == userId;
      allow delete: if isUserInRole('Admin');
    }

    match /leads/{leadId} {
      allow read: if isUserInRole('Admin') || request.auth.uid == resource.data.ownerId;
      allow create: if isUserInRole('Admin') || isUserInRole('Sales Rep');
      allow update: if isUserInRole('Admin') || (isUserInRole('Sales Rep') && request.auth.uid == resource.data.ownerId);
      allow delete: if isUserInRole('Admin');
    }
  }
}
