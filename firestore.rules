rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Allow users to read the list of all users
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Allow users to read/write their own leads
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    // Rules for conversations
    match /conversations/{conversationId} {
      // Allow create if the user is authenticated and is a participant
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      
      // Allow read/update if the user is a participant
      allow read, update: if request.auth != null && resource.data.participants.hasAny([request.auth.uid]);

      // Rules for messages within a conversation
      match /messages/{messageId} {
        // Allow create if user is a participant in the parent conversation
        allow create: if request.auth != null && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
        
        // Allow read if user is a participant in the parent conversation
        allow read: if request.auth != null && get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
      }
    }
  }
}
