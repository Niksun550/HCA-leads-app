rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isUserOneOfRoles(roles) {
      return request.auth.token.role in roles;
    }

    match /users/{userId} {
      allow list: if isUserOneOfRoles(['Admin', 'Director', 'Viewer', 'Sales Rep']);
      allow read: if request.auth.uid == userId || isUserOneOfRoles(['Admin', 'Director', 'Viewer']);
      allow write: if request.auth.uid == userId;
    }

    match /leads/{leadId} {
      allow list: if isUserOneOfRoles(['Admin', 'Viewer', 'Director', 'Sales Rep', 'Structure']);
      allow read: if request.auth.uid == resource.data.ownerId || 
                     request.auth.uid == resource.data.structureTeamMemberId || 
                     isUserOneOfRoles(['Admin', 'Viewer', 'Director']) ||
                     (isUserOneOfRoles(['Structure']) && resource.data.status in ['Structure Pending', 'Site Visit Done', 'IN Design', 'Quotation Send']);
      allow write: if request.auth.uid == resource.data.ownerId || 
                      request.auth.uid == resource.data.structureTeamMemberId ||
                      isUserOneOfRoles(['Admin', 'Director']);
      allow create: if request.auth != null;
      allow delete: if isUserOneOfRoles(['Admin']);
    }
    
    match /tasks/{taskId} {
      allow read: if request.auth.uid == resource.data.assigneeId || 
                     request.auth.uid == resource.data.createdBy ||
                     isUserOneOfRoles(['Admin', 'Director', 'Viewer']);
      allow write: if request.auth.uid == resource.data.assigneeId || 
                      request.auth.uid == resource.data.createdBy ||
                      isUserOneOfRoles(['Admin']);
      allow create: if request.auth != null;
      allow delete: if request.auth.uid == resource.data.createdBy || isUserOneOfRoles(['Admin']);
    }
    
    match /conversations/{conversationId} {
      allow read, write: if request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
        allow read, create: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
