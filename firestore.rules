rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Users can be read by any authenticated user to populate lists,
    // but only the user themselves can update their own document.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }

    // Leads can be read or written by any authenticated user.
    // In a real production app, you'd likely make this more restrictive
    // based on user roles (e.g., Sales Rep can only see their own leads).
    match /leads/{leadId} {
      allow read, write: if request.auth != null;
    }

    // Rules for conversations and their sub-collections (messages).
    match /conversations/{conversationId} {
      // Allow creation if the user is authenticated and is one of the participants.
      allow create: if request.auth != null && request.auth.uid in request.resource.data.participants;
      
      // Allow read and update if the user is one of the participants.
      allow read, update: if request.auth != null && request.auth.uid in resource.data.participants;
      
      // Rules for the messages sub-collection within a conversation.
      match /messages/{messageId} {
        // Allow users to read/write messages only if they are a participant
        // in the parent conversation document.
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
