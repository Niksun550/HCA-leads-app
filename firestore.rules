
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to check if the user is one of the participants
    function isParticipant(participants) {
      return request.auth.uid in participants;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && request.auth.uid == userId;
    }

    match /leads/{leadId} {
      allow read, write: if isAuthenticated();
      // More granular rules can be added here based on user roles
    }

    match /conversations/{conversationId} {
      allow read, update: if isAuthenticated() && isParticipant(resource.data.participants);
      allow create: if isAuthenticated() && isParticipant(request.resource.data.participants);
      
      match /messages/{messageId} {
        allow read, create: if isAuthenticated() && isParticipant(get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants);
      }
    }
  }
}
