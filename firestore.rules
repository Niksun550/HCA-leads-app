
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isUserAuthenticated() {
      return request.auth != null;
    }

    function isUserRole(role) {
      return isUserAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }

    function isUserRoleIn(roles) {
      return isUserAuthenticated() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
    }

    match /users/{userId} {
      allow read: if isUserAuthenticated();
      allow write: if isUserAuthenticated() && request.auth.uid == userId;
    }

    match /leads/{leadId} {
      allow read: if isUserAuthenticated() && 
                    (isUserRoleIn(['Admin', 'Viewer', 'Director']) || 
                     request.auth.uid == resource.data.ownerId ||
                     (isUserRole('Structure') && (request.auth.uid == resource.data.structureTeamMemberId || resource.data.status == 'Structure Pending')));
      allow create: if isUserAuthenticated();
      allow update: if isUserAuthenticated() && 
                      (isUserRole('Admin') || 
                       request.auth.uid == resource.data.ownerId || 
                       (isUserRole('Structure') && request.auth.uid == resource.data.structureTeamMemberId));
      allow delete: if isUserRole('Admin');
    }

    match /conversations/{conversationId} {
      allow read, update: if isUserAuthenticated() && request.auth.uid in resource.data.participants;
      allow create: if isUserAuthenticated(); 
      
      match /messages/{messageId} {
        allow read, create: if isUserAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }

    match /tasks/{taskId} {
      allow read: if isUserAuthenticated() && (isUserRoleIn(['Admin', 'Director']) || request.auth.uid == resource.data.assigneeId);
      allow create: if isUserAuthenticated();
      allow update: if isUserAuthenticated() && (isUserRole('Admin') || request.auth.uid == resource.data.assigneeId || request.auth.uid == resource.data.createdBy);
      allow delete: if isUserAuthenticated() && (isUserRole('Admin') || request.auth.uid == resource.data.createdBy);
    }
  }
}
