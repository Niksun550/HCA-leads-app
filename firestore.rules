rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check user role from their user document
    function getRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }
    
    // Users can read other user profiles to start chats, but can only write to their own profile.
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;
    }
    
    // Leads have role-based access control.
    match /leads/{leadId} {
      function userRole() {
        return getRole(request.auth.uid);
      }
      
      allow read: if userRole() in ['Admin', 'Viewer', 'Director']
                  || (userRole() == 'Sales Rep' && resource.data.ownerId == request.auth.uid)
                  || (userRole() == 'Structure' && (resource.data.structureTeamMemberId == request.auth.uid || resource.data.status == 'Structure Pending'));
      
      allow create: if userRole() in ['Admin', 'Sales Rep'];
      allow update: if userRole() in ['Admin', 'Sales Rep', 'Structure'];
      allow delete: if userRole() == 'Admin';
    }

    // Rules for conversations and their nested messages.
    match /conversations/{conversationId} {
      // Allow read if the user is a participant in the conversation.
      allow read: if request.auth.uid in resource.data.participants;
      
      // Allow write (create/update) if the user is a participant. For creation, check the incoming data.
      allow write: if request.auth.uid in request.resource.data.participants;
      
      // Messages can only be accessed by participants of the parent conversation.
      match /messages/{messageId} {
        allow read, write: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
