
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to get the user's role from their user document.
    function getUserRole(userId) {
      return get(/databases/$(database)/documents/users/$(userId)).data.role;
    }

    // Rules for the 'users' collection
    match /users/{userId} {
      // Any authenticated user can read user documents. This is needed for the app to function correctly.
      allow read: if request.auth != null;
      // Users can create their own document when signing up.
      allow create: if request.auth.uid == userId;
      // Users can only update their own document.
      allow update: if request.auth.uid == userId;
      // Only Admins can delete users.
      allow delete: if getUserRole(request.auth.uid) == 'Admin';
    }

    // Rules for the 'leads' collection
    match /leads/{leadId} {
      // Admins can perform any action.
      // Sales Reps and Viewers can read leads assigned to them.
      allow read: if getUserRole(request.auth.uid) == 'Admin' 
                  || (request.auth.uid == resource.data.ownerId && (getUserRole(request.auth.uid) == 'Sales Rep' || getUserRole(request.auth.uid) == 'Viewer'));
      
      // Admins and Sales Reps can create leads.
      allow create: if getUserRole(request.auth.uid) == 'Admin' || getUserRole(request.auth.uid) == 'Sales Rep';

      // Admins can update any lead.
      // Sales Reps can update leads assigned to them.
      allow update: if getUserRole(request.auth.uid) == 'Admin' || (request.auth.uid == resource.data.ownerId && getUserRole(request.auth.uid) == 'Sales Rep');

      // Only Admins can delete leads.
      allow delete: if getUserRole(request.auth.uid) == 'Admin';
    }
  }
}
