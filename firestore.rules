
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    // Helper function to check for admin role
    function isAdmin() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }
    
    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
      allow create: if isAuthenticated(); // Allow users to be created during registration
      allow update: if request.auth.uid == userId || isAdmin(); // Allow users to update their own profile or admins to update any
    }

    match /leads/{leadId} {
      // READ
      allow get: if isAuthenticated();
      allow list: if 
          isAuthenticated() && (
            resource.data.ownerId == request.auth.uid ||
            resource.data.structureTeamMemberId == request.auth.uid ||
            (resource.data.status == 'Structure Pending' && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Structure') ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Viewer', 'Director']
          );

      // WRITE (CREATE, UPDATE, DELETE)
      allow create: if 
          isAuthenticated() && (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['Admin', 'Sales Rep']);
      allow update: if 
          isAuthenticated() && (
            isAdmin() || 
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Sales Rep' && resource.data.ownerId == request.auth.uid) ||
            (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Structure' && resource.data.structureTeamMemberId == request.auth.uid)
          );
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read, write: if get(/databases/$(database)/documents/leads/$(leadId)).data.ownerId == request.auth.uid ||
                               isAdmin() ||
                               (get(/databases/$(database)/documents/leads/$(leadId)).data.structureTeamMemberId == request.auth.uid);
      }
    }
    
    match /conversations/{conversationId} {
      allow get, list, create: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow update: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      match /messages/{messageId} {
         allow read, write, create: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}
