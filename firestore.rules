rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if a user has a specific role
    function hasRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // Helper function to check if the user is the owner of a document
    function isOwner(doc) {
      return request.auth.uid == doc.data.ownerId;
    }

    // Helper function to check if the user is assigned to the structure team for a lead
    function isStructureTeamMember(doc) {
      return request.auth.uid == doc.data.structureTeamMemberId;
    }

    match /users/{userId} {
      // Allow any authenticated user to read the list of users.
      // Allow admins to read any specific user document.
      allow read: if request.auth != null;
      
      // Allow users to update their own data (but not their role)
      allow update: if request.auth.uid == userId && !('role' in request.resource.data);
      // Only admins can change roles
      allow update: if hasRole('Admin') && 'role' in request.resource.data;
      // Allow new user creation
      allow create: if request.auth.uid == userId;
    }

    match /leads/{leadId} {
      // Admins can do anything
      allow read, write: if hasRole('Admin');
      
      // Sales Reps can create leads, and can read/write their own leads
      allow create: if hasRole('Sales Rep');
      allow read, update: if hasRole('Sales Rep') && isOwner(resource);
      
      // Viewers can only read all leads
      allow read: if hasRole('Viewer');

      // Structure team can read/update leads assigned to them
      allow read, update: if hasRole('Structure') && isStructureTeamMember(resource);
    }
  }
}