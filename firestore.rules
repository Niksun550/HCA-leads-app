
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if the user has a specific role
    function hasRole(role) {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
    }
    
    // Helper function to check if user is an owner of the lead
    function isOwner(lead) {
      return request.auth.uid == lead.ownerId;
    }
    
    // Helper function to check if user is a structure team member on the lead
    function isStructureMember(lead) {
      return request.auth.uid == lead.structureTeamMemberId;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if hasRole('Admin') || request.auth.uid == userId;
    }

    match /leads/{leadId} {
      // Admins, Directors, and Viewers can read all leads
      // Sales Reps can read leads they own
      // Structure members can read leads assigned to them OR leads that are pending for the structure team
      allow read: if request.auth != null &&
                    (hasRole('Admin') || hasRole('Director') || hasRole('Viewer') ||
                     (hasRole('Sales Rep') && isOwner(resource.data)) ||
                     (hasRole('Structure') && (isStructureMember(resource.data) || resource.data.status in ['Site Visit Done', 'IN Design', 'Quotation Send', 'Structure Pending'])));

      // Admins, Sales Reps (if owner), and Structure members (if assigned) can create/update
      allow write: if request.auth != null &&
                     (hasRole('Admin') ||
                      (hasRole('Sales Rep') && (isOwner(request.resource.data) || isOwner(resource.data))) ||
                      (hasRole('Structure') && (isStructureMember(request.resource.data) || isStructureMember(resource.data))));
                      
      allow delete: if hasRole('Admin');
    }

    match /conversations/{conversationId} {
      // Allow read and write only if the user is a participant in the conversation
      allow read, update, delete: if request.auth.uid in resource.data.participants;
      
      // Allow create if the user is in the participants list of the new document
      allow create: if request.auth.uid in request.resource.data.participants;

      match /messages/{messageId} {
         // Allow read and write only if the user is a participant in the conversation
         allow read, write: if request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
  }
}

    