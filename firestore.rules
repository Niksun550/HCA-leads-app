
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isUserInRole(roles) {
      return request.auth != null && request.auth.token.role in roles;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId || isUserInRole(['Admin']);
    }

    match /leads/{leadId} {
      // Rule for getting a single document
      allow get: if isUserInRole(['Admin', 'Director', 'Viewer'])
                   || (isUserInRole(['Sales Rep']) && resource.data.ownerId == request.auth.uid)
                   || (isUserInRole(['Structure']) && (resource.data.structureTeamMemberId == request.auth.uid || resource.data.status in ['Structure Pending', 'Site Visit Done', 'IN Design', 'Quotation Send']));
      
      // Rule for querying a list of documents
      allow list: if isUserInRole(['Admin', 'Director', 'Viewer'])
                   || (isUserInRole(['Sales Rep']) && request.query.where.path == 'ownerId' && request.query.where.op == '==' && request.query.where.value == request.auth.uid)
                   || (isUserInRole(['Structure']) && request.query.where.path == 'structureTeamMemberId' && request.query.where.op == '==' && request.query.where.value == request.auth.uid)
                   || (isUserInRole(['Structure']) && request.query.where.path == 'status' && request.query.where.op == 'in');


      // Rules for writing data
      allow create, update, delete: if isUserInRole(['Admin', 'Director'])
                                     || (isUserInRole(['Sales Rep']) && resource.data.ownerId == request.auth.uid)
                                     || (isUserInRole(['Structure']) && resource.data.structureTeamMemberId == request.auth.uid);
    }

    match /conversations/{conversationId} {
      allow read, write: if request.auth != null && request.auth.uid in resource.data.participants;

      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
    
    match /tasks/{taskId} {
        allow read, write: if request.auth != null && request.auth.uid == resource.data.assigneeId;
        allow create: if request.auth != null;
        allow delete: if request.auth != null && (request.auth.uid == resource.data.createdBy || isUserInRole(['Admin']));
    }
  }
}
