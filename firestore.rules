
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuth() {
      return request.auth != null;
    }
    
    function isUser(uid) {
      return isAuth() && request.auth.uid == uid;
    }
    
    function userRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    function isAdmin() {
      return isAuth() && userRole() == 'Admin';
    }
    
    function isDirector() {
      return isAuth() && userRole() == 'Director';
    }

    function isViewer() {
        return isAuth() && userRole() == 'Viewer';
    }

    function isSalesRep() {
        return isAuth() && userRole() == 'Sales Rep';
    }

    function isStructure() {
        return isAuth() && userRole() == 'Structure';
    }

    match /users/{userId} {
      // Any authenticated user can read their own data.
      // Admins can read any user's data.
      allow read: if isUser(userId) || isAdmin();
      
      // Any authenticated user can update their own data.
      // Admins can update any user's data.
      allow update: if isUser(userId) || isAdmin();

      // Only allow creating a user document if the user is creating their own.
      allow create: if isUser(userId);
    }
    
    match /leads/{leadId} {
      // Admins, Directors, and Viewers can read all leads.
      // Sales Reps can read leads they own.
      // Structure members can read leads assigned to them or in their workflow.
      allow read: if isAdmin() || isDirector() || isViewer() || 
                  (isSalesRep() && resource.data.ownerId == request.auth.uid) ||
                  (isStructure() && (resource.data.structureTeamMemberId == request.auth.uid || resource.data.status in ['Site Visit Done', 'IN Design', 'Quotation Send', 'Structure Pending']));

      // Admins, Directors can write to any lead.
      // Sales Reps can create/update their own leads.
      // Structure members can update leads assigned to them.
      allow write: if isAdmin() || isDirector() ||
                   (isSalesRep() && (resource == null || resource.data.ownerId == request.auth.uid)) ||
                   (isStructure() && resource.data.structureTeamMemberId == request.auth.uid);
                   
      allow list: if isAdmin() || isDirector() || isViewer();
    }
    
    match /tasks/{taskId} {
      // Users can read/write tasks assigned to them, or created by them.
      // Admins/Directors can read all tasks.
      allow read: if isAdmin() || isDirector() ||
                  (isAuth() && (resource.data.assigneeId == request.auth.uid || resource.data.createdBy == request.auth.uid));
      allow write: if isAuth() && (resource == null || resource.data.assigneeId == request.auth.uid || resource.data.createdBy == request.auth.uid);
    }

    match /conversations/{conversationId} {
        // Users can only access conversations they are a part of.
        allow read, write, delete: if isAuth() && request.auth.uid in resource.data.participants;
        
        match /messages/{messageId} {
             // Users can only read/write messages in conversations they are a part of.
             allow read, write: if isAuth() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        }
    }
  }
}
