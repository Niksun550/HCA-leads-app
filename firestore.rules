
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
  
    function isAuth() {
      return request.auth != null;
    }
    
    function isUser(userId) {
      return isAuth() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    function isSalesRep() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Sales Rep';
    }
    
    function isViewer() {
        return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Viewer';
    }

    function isStructureTeamMember() {
      return isAuth() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Structure';
    }

    match /users/{userId} {
      allow create: if request.auth.uid == userId;
      allow read: if isUser(userId) || isAdmin();
      allow update: if isUser(userId) || isAdmin(); 
      allow delete: if false; // Generally, don't allow user deletion from client
    }

    match /leads/{leadId} {
      allow read: if isAuth() && (isAdmin() || isViewer());
      allow create: if isAuth() && (isAdmin() || isSalesRep());

      // Allow Admins to write to any lead
      // Allow Sales Rep to write to their own lead
      // Allow Structure team to write to leads assigned to them
      allow write: if isAuth() && 
                    (isAdmin() || 
                    (isSalesRep() && resource.data.ownerId == request.auth.uid) ||
                    (isStructureTeamMember() && resource.data.structureTeamMemberId == request.auth.uid));

      // Granular update/delete for non-admins
      allow update: if isAuth() && 
                    (isSalesRep() && resource.data.ownerId == request.auth.uid) ||
                    (isStructureTeamMember() && resource.data.structureTeamMemberId == request.auth.uid);
      
      allow delete: if isAdmin();
    }
  }
}
