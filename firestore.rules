rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'Admin';
    }

    match /leads/{leadId} {
      function isRole(role) {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role;
      }
      
      function isOneOfRoles(roles) {
        return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in roles;
      }

      function isOwner() {
        return request.auth.uid == resource.data.ownerId;
      }

      function isStructureMember() {
        return request.auth.uid == resource.data.structureTeamMemberId;
      }
      
      // Broader read access for roles that need to see everything
      allow list, get: if isOneOfRoles(['Admin', 'Director', 'Viewer']);
      
      // Finer-grained read access for other roles
      allow get: if isOwner() || isStructureMember();

      // Write access rules
      allow create: if isOneOfRoles(['Admin', 'Sales Rep', 'Director']);
      allow update: if isOneOfRoles(['Admin', 'Director']) || isOwner() || isStructureMember();
      allow delete: if isOneOfRoles(['Admin', 'Director']);
    }

    match /leads/{leadId}/messages/{messageId} {
      // Allow anyone who can view the lead to view the messages
      allow read: if exists(/databases/$(database)/documents/leads/$(leadId));
      // Only allow authenticated users to write messages
      allow write: if request.auth != null;
    }

    match /conversations/{conversationId} {
      allow read, write: if request.auth.uid in resource.data.participants;
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read, write: if get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants.hasAny([request.auth.uid]);
    }
    
    match /tasks/{taskId} {
      function isAssignee() {
        return request.auth.uid == resource.data.assigneeId;
      }

      function wasCreator() {
        return request.auth.uid == resource.data.createdBy;
      }
       
      allow read: if isAssignee() || wasCreator();
      allow write: if request.auth.uid != null; // Allow any logged in user to create/update tasks, more specific logic is in the app
      
      // Allow querying by assigneeId
       allow list: if request.auth.uid == request.query.where.assigneeId;
    }
  }
}
