
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper function to check if a user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to get the user's role from the users collection
    function getRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }
    
    // Helper function to check if the user is an Admin
    function isAdmin() {
      return isAuthenticated() && getRole() == 'Admin';
    }

    // Secure the users collection
    match /users/{userId} {
      // Admins can read/write any user document
      // Users can read/write their own document
      allow read, write: if isAdmin() || request.auth.uid == userId;
      // Authenticated users can list all users to enable communication features
      allow list: if isAuthenticated();
    }
    
    // Secure the leads collection
    match /leads/{leadId} {
        // Admins, Directors, and Viewers can read any lead
        allow read: if isAuthenticated() && (getRole() in ['Admin', 'Director', 'Viewer']);
        // Sales Reps can read leads they own
        allow read: if isAuthenticated() && getRole() == 'Sales Rep' && resource.data.ownerId == request.auth.uid;
        // Structure team can read leads assigned to them or in their workflow
        allow read: if isAuthenticated() && getRole() == 'Structure' && (resource.data.structureTeamMemberId == request.auth.uid || resource.data.status in ['Structure Pending', 'Site Visit Done', 'IN Design', 'Quotation Send']);
        
        // Admins and Directors can write to any lead
        allow write: if isAuthenticated() && getRole() in ['Admin', 'Director'];
        // Sales Reps can write to leads they own
        allow write: if isAuthenticated() && getRole() == 'Sales Rep' && resource.data.ownerId == request.auth.uid;
        // Structure team can write to leads assigned to them
        allow write: if isAuthenticated() && getRole() == 'Structure' && resource.data.structureTeamMemberId == request.auth.uid;
        
        // Allow creating a lead if the user is authenticated and not a viewer
        allow create: if isAuthenticated() && getRole() != 'Viewer';
        
        // Allow authenticated users to list leads to populate the dashboard
        allow list: if isAuthenticated();
    }

    // Secure the tasks collection
    match /tasks/{taskId} {
      // Users can read/write tasks assigned to them
      allow read, write: if isAuthenticated() && resource.data.assigneeId == request.auth.uid;
      // Users can create tasks
      allow create: if isAuthenticated();
      // Users can delete tasks they created, or Admins can delete any task
      allow delete: if isAuthenticated() && (resource.data.createdBy == request.auth.uid || getRole() == 'Admin');
      // Allow authenticated users to list tasks
      allow list: if isAuthenticated();
    }

    // Secure conversations
    match /conversations/{conversationId} {
      // Only participants can read/write the conversation document
      allow read, write: if isAuthenticated() && request.auth.uid in resource.data.participants;
      
      // Secure messages subcollection
      match /messages/{messageId} {
         // Only participants can read/write messages
        allow read, write: if isAuthenticated() && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
      }
    }
    
    // Secure settings collection (for branding)
    match /settings/{settingId} {
        // Anyone can read branding settings
        allow read: if true;
        // Only Admins can write to settings
        allow write: if isAdmin();
    }
  }
}
